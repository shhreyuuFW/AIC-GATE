# Application Environment (development | production)
AIC_GATE_ENV=development

# JWT Authentication (required >=32 chars in production; ephemeral in development if blank)
AIC_GATE_JWT_SECRET=
AIC_GATE_JWT_TTL_MINUTES=60

# Local Demo Accounts (disabled automatically when AIC_GATE_ENV=production)
AIC_GATE_DEMO_USERS_ENABLED=1
AIC_GATE_DEMO_REQUESTER_PASSWORD=operator-demo-pass
AIC_GATE_DEMO_ADMIN_PASSWORD=commander-demo-pass

# Explicit CORS origins (comma-separated)
AIC_GATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000

# AWS Region and Credentials Mode
AWS_REGION=ap-south-1
# Set to 1 in workload/serverless environments to use default IAM role/env credentials instead of named CLI profiles
AIC_GATE_USE_DEFAULT_AWS_CREDS=0

# Local AWS CLI Profiles (used when AIC_GATE_USE_DEFAULT_AWS_CREDS=0)
AIC_GATE_AWS_PROFILE=aic-gate-logs-reader
AIC_GATE_STS_PROFILE=aic-gate-dev

# AWS IAM & DynamoDB Resources
AIC_GATE_AWS_ACCOUNT_ID=023644376485
AIC_GATE_JIT_ROLE_ARN=arn:aws:iam::023644376485:role/AICGateJITRole
AIC_GATE_SESSIONS_TABLE=AICGateSession
AIC_GATE_REQUESTS_TABLE=AICGateAccessRequest
AIC_GATE_IDENTITY_TABLE=AICGateIdentity
# memory | dynamodb (use dynamodb once AICGateIdentity table exists)
AIC_GATE_IDENTITY_BACKEND=memory

# Comma-separated allowlist of S3 buckets permitted for JIT access requests
AIC_GATE_ALLOWED_BUCKETS=cloudsec.proj.aicgate
